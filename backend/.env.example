# Backend environment variables (sample)
# Copy this file to `.env` and fill in real values.

PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Aiven or any Postgres provider)
DATABASE_URL=postgres://avnadmin:password@host.aivencloud.com:12345/defaultdb?sslmode=require

# Anti-spam / admin
ADMIN_TOKEN=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string
ADMIN_PREFIX=/api/love-admin
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=https://stuck-on-you.vercel.app,http://localhost:5173

# Set on Vercel
VERCEL=1
